# Copy this file to .env.local to change the defaults. Everything here is optional.

# Where Ollama is listening
OLLAMA_URL=http://127.0.0.1:11434

# Force specific models (otherwise the app picks the best one you have installed,
# and you can also choose in Settings inside the app)
# OLLAMA_TEXT_MODEL=qwen3.5:9b
# OLLAMA_VISION_MODEL=qwen3.5:9b

# How long Ollama keeps the model in memory after the last request
OLLAMA_KEEP_ALIVE=15m

# Context window in tokens. Leave unset to use Ollama's default (4096), which is plenty.
# Bigger values need more graphics memory and can make a busy GPU much slower.
# OLLAMA_NUM_CTX=4096

# Where your food log and photos are stored (default: ./data)
# DATA_DIR=D:\bitewise-data
